<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center"
    android:orientation="vertical" android:padding="10dp">
    <ImageView android:id="@+id/w_power" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="10dp" android:src="@drawable/ic_power" android:contentDescription="Ligar ou desligar"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <ImageView android:id="@+id/w_c0" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:src="@drawable/circle" android:contentDescription="@null"/>
        <ImageView android:id="@+id/w_c1" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:src="@drawable/circle" android:contentDescription="@null"/>
        <ImageView android:id="@+id/w_c2" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:src="@drawable/circle" android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
